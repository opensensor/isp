static int32_t tisp_sdns_all_reg_refresh_lit(uint32_t ch, uint32_t ev)
{
    (void)tisp_sdns_intp_lit(ch, ev);
    (void)tisp_sdns_noref_reg_cfg_lit(ch);
    (void)tisp_sdns_ref_reg_cfg_lit(ch);
    return tisp_sdns_reg_trig_lit(ch);
}

static int32_t tisp_sdns_intp_reg_refresh_lit(uint32_t ch, uint32_t ev)
{
    (void)tisp_sdns_intp_lit(ch, ev);
    (void)tisp_sdns_ref_reg_cfg_lit(ch);
    return tisp_sdns_reg_trig_lit(ch);
}

static int32_t tisp_sdns_par_refresh_lit(uint32_t ch, uint32_t ev, uint32_t thresh)
{
    uint32_t old = regtrace_sdns_gain_old[ch];
    uint32_t d;

    if (old == 0xffffffffU) {
        regtrace_sdns_gain_old[ch] = ev;
        return tisp_sdns_all_reg_refresh_lit(ch, ev);
    }
    d = (ev < old) ? old - ev : ev - old;
    if (d < thresh)
        return 0;
    regtrace_sdns_gain_old[ch] = ev;
    return tisp_sdns_intp_reg_refresh_lit(ch, ev);
}

static int32_t tisp_sdns_params_refresh_lit(uint32_t ch)
{
    uintptr_t dst = ch ? sec_sdns : main_sdns;
    uintptr_t bank = tparamsN[ch];

    if (!dst || !bank)
        return -1;
    memcpy((void *)dst, (const void *)(bank + 0x17b00U), 2900);
    return 0;
}

static int32_t regtrace_sdns_main_init_lit(void)
{
    /* OEM tisp_sdns_main_init 0x63a5c */
    void *par, *comb, *wrk;

    if (!main_sdns) {
        par = (void *)(uintptr_t)
            ((uintptr_t (*)(uintptr_t))(uintptr_t)private_vmalloc)(2900);
        comb = (void *)(uintptr_t)
            ((uintptr_t (*)(uintptr_t))(uintptr_t)private_vmalloc)(500);
        wrk = (void *)(uintptr_t)
            ((uintptr_t (*)(uintptr_t))(uintptr_t)private_vmalloc)(126);
        if (!par || !comb || !wrk)
            return -ENOMEM;
        memset(par, 0, 2900);
        memset(comb, 0, 500);
        memset(wrk, 0, 126);
        main_sdns = (uintptr_t)par;
        main_sdns_comb = (uintptr_t)comb;
        main_sdns_intp = (uintptr_t)wrk;
    }
    regtrace_sdns_gain_old[0] = 0xffffffffU;
    if (tisp_sdns_params_refresh_lit(0))
        return -ENOENT;
    (void)tisp_sdns_wdr_en_lit(0, sdns_wdr_en_flags[0]);
    (void)tisp_sdns_all_reg_refresh_lit(0, 0x10000U);
    printk(KERN_WARNING "tx_isp_t40_recovered: sdns-main-init-lit done par=%p comb[0]=%p comb[124]=%p\n",
           (void *)(uintptr_t)main_sdns,
           (void *)(uintptr_t)((uint32_t *)(uintptr_t)main_sdns_comb)[0],
           (void *)(uintptr_t)((uint32_t *)(uintptr_t)main_sdns_comb)[124]);
    return 0;
}
